{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "papier", "name": "Papier", "color": "#FBFAF7" },
				{ "slug": "sable", "name": "Sable", "color": "#F3EFE7" },
				{ "slug": "encre", "name": "Encre", "color": "#0F1F1C" },
				{ "slug": "gris", "name": "Gris texte", "color": "#3E4F4B" },
				{ "slug": "teal", "name": "Teal profond", "color": "#00564B" },
				{ "slug": "teal-2", "name": "Teal", "color": "#00796B" },
				{ "slug": "ocre", "name": "Ocre (texte)", "color": "#A85614" },
				{ "slug": "ocre-vif", "name": "Ocre vif", "color": "#E08A3C" },
				{ "slug": "ocre-clair", "name": "Ocre clair", "color": "#F0B37A" },
				{ "slug": "blanc", "name": "Blanc", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Bricolage Grotesque", "fontFamily": "'Bricolage Grotesque', system-ui, sans-serif" },
				{ "slug": "serif", "name": "Source Serif 4", "fontFamily": "'Source Serif 4', Georgia, serif" },
				{ "slug": "mono", "name": "JetBrains Mono", "fontFamily": "'JetBrains Mono', ui-monospace, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Petit", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Moyen", "size": "1.25rem" },
				{ "slug": "large", "name": "Grand", "size": "1.5rem", "fluid": { "min": "1.3rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "xx-large", "name": "Énorme", "size": "5rem", "fluid": { "min": "2.75rem", "max": "5rem" } }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1.25rem" },
				{ "slug": "40", "name": "M", "size": "2rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3.5rem, 8vw, 5.5rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--papier)", "text": "var(--wp--preset--color--encre)" },
		"spacing": { "padding": { "left": "1.5rem", "right": "1.5rem" }, "blockGap": "1.5rem" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--teal)" },
				":hover": { "color": { "text": "var(--wp--preset--color--encre)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "lineHeight": "1.1", "letterSpacing": "-0.025em" },
				"color": { "text": "var(--wp--preset--color--encre)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--teal)", "text": "var(--wp--preset--color--blanc)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "fontSize": "1.0625rem" },
				":hover": { "color": { "background": "var(--wp--preset--color--encre)" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "fontSize": "1rem" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "800", "fontSize": "1.5rem", "letterSpacing": "-0.02em" }, "elements": { "link": { "color": { "text": "var(--wp--preset--color--encre)" } } } },
			"core/post-title": { "elements": { "link": { "color": { "text": "var(--wp--preset--color--encre)" } } } },
			"core/post-date": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.8125rem", "textTransform": "uppercase", "letterSpacing": "0.06em" }, "color": { "text": "var(--wp--preset--color--gris)" } },
			"core/post-excerpt": { "color": { "text": "var(--wp--preset--color--gris)" }, "typography": { "fontSize": "1.0625rem", "lineHeight": "1.55" } },
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--ocre-vif)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.75rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "fontSize": "1.75rem", "lineHeight": "1.3" }
			},
			"core/pullquote": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600" } },
			"core/code": {
				"color": { "background": "var(--wp--preset--color--encre)", "text": "#DCEDEA" },
				"border": { "radius": "14px" },
				"spacing": { "padding": { "top": "1.4rem", "bottom": "1.4rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.9375rem" }
			},
			"core/separator": { "color": { "text": "#E3DED4" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-pleine-largeur", "title": "Page pleine largeur", "postTypes": ["page"] }
	]
}
